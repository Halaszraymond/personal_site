---
/**
 * The dev-only Kálmán playground at /playground/.
 *
 * Not a file in src/pages/: astro.config.ts adds this page as a route only in the
 * development server and in builds with PLAYGROUND=1, so production never contains it
 * (spec: kalman-playground). English only while dev-only; not indexed; no language switcher.
 *
 * Layout: the 3D view and the action buttons, then the controls, then the config JSON.
 * Side by side on wide screens, stacked on phones.
 */
import BaseLayout from '../components/BaseLayout.astro';
import { PLAYGROUND_EN as TEXT } from '../i18n/playground';
import { exportConfig } from '../lib/kalman-config';
import { repoConfig } from '../scene/kalman/repo-config';
import Controls from './Controls.astro';

const config = repoConfig();
---

<BaseLayout locale="en" currentLocale={null} showLanguageSwitcher={false} title={TEXT.title}>
  <h1>{TEXT.heading}</h1>
  <p>{TEXT.intro}</p>

  <div class="playground">
    <section class="stage" aria-label={TEXT.viewLabel}>
      <div class="view" data-view>
        <canvas aria-label={TEXT.viewLabel} role="img"></canvas>
        <p class="no-webgl" data-no-webgl hidden>
          {TEXT.noWebGL}
        </p>
      </div>
      <div class="actions">
        <button type="button" data-action="swim" aria-pressed="false">
          {TEXT.swimPlay}
        </button>
        <button type="button" data-action="reset-view">
          {TEXT.resetView}
        </button>
        <button type="button" data-action="reset">
          {TEXT.reset}
        </button>
        <button type="button" data-action="copy">
          {TEXT.copyConfig}
        </button>
      </div>
      <p class="status" role="status" data-status></p>
    </section>

    <Controls config={config} />

    <section class="config">
      <label for="config-json">{TEXT.configLabel}</label>
      <textarea
        id="config-json"
        readonly
        rows="12"
        data-config-json
      >{exportConfig(config)}</textarea>
    </section>
  </div>
</BaseLayout>

<script>
  import { startPlayground } from './playground-client';

  startPlayground();
</script>

<style>
  /* The playground needs more room than the reading width of the content pages. */
  :global(body) {
    max-width: 72rem;
  }

  .playground {
    display: grid;
    gap: 1rem;
  }

  /* Wide screens: the view stays in sight on the left while the controls scroll. */
  @media (min-width: 56rem) {
    .playground {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }

    .stage {
      position: sticky;
      top: 1rem;
    }

    .config {
      grid-column: 1 / -1;
    }
  }

  .view {
    aspect-ratio: 4 / 5;
    max-height: 70vh;
    width: 100%;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #eef3f7;
    display: grid;
    place-items: center;
  }

  .view canvas {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none; /* dragging turns Kálmán instead of scrolling the page */
  }

  .no-webgl {
    padding: 1rem;
    text-align: center;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .actions button {
    font: inherit;
    padding: 0.4rem 0.8rem;
  }

  .status {
    min-height: 1.5em;
  }

  .config textarea {
    display: block;
    width: 100%;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
  }
</style>
