---
/**
 * The preview's controls, built at build time from the repo's data, so there is always exactly
 * one play button per animation, one pose button per named pose, one rotation slider per layer
 * and one stretch slider per layer that may stretch, for each figure (spec: kalman-preview).
 *
 * All plain HTML: buttons, radio buttons, checkboxes shown as switches and range sliders.
 * Keyboard support, labels and screen-reader output come from the browser. The side figure's
 * pose buttons and sliders are in the page too, `hidden` until that figure is chosen.
 * preview-client.ts connects everything to the figure and the player.
 */
import { layerLabel, PREVIEW_EN as TEXT } from '../i18n/preview';
import { playLength } from '../lib/kalman-animation';
import { FIGURES } from '../lib/kalman-rig';
import { canTurn } from '../lib/kalman-turntable';
import { posesFor, REPO_ANIMATIONS, REPO_RIGS, REPO_TURNTABLE } from '../scene/kalman/repo-rig';

const showTurnControl = canTurn(REPO_TURNTABLE);
// The scrub slider starts on the first animation (idle); the script changes it per animation.
const firstAnimation = REPO_ANIMATIONS[0];
const firstDuration = firstAnimation === undefined ? 1 : playLength(firstAnimation);
---

<div class="controls">
  <fieldset>
    <legend>{TEXT.animationsLegend}</legend>
    <div class="pose-buttons">
      {REPO_ANIMATIONS.map((animation) => (
        <button type="button" data-animation-button={animation.name} aria-pressed="false">
          {TEXT.play} {animation.label.toLowerCase()}
        </button>
      ))}
    </div>
    <label class="switch">
      <input type="checkbox" role="switch" data-idle-switch />
      {TEXT.idleLoop}
    </label>
    <div class="slider">
      <label for="scrub">{TEXT.scrub}</label>
      <input
        type="range"
        id="scrub"
        data-scrub-slider
        min="0"
        max={firstDuration}
        step="0.01"
        value="0"
      />
      <output for="scrub" data-scrub-value>
        0.00 s
      </output>
    </div>
  </fieldset>

  <fieldset>
    <legend>{TEXT.figureLegend}</legend>
    <div class="choices">
      {FIGURES.map((figure) => (
        <label class="switch">
          <input
            type="radio"
            name="figure"
            value={figure}
            data-figure-choice
            checked={figure === 'front'}
          />
          {TEXT.figures[figure]}
        </label>
      ))}
    </div>
  </fieldset>

  <fieldset>
    <legend>{TEXT.posesLegend}</legend>
    {FIGURES.map((figure) => (
      <div class="pose-buttons" data-figure-poses={figure} hidden={figure !== 'front'}>
        {posesFor(figure).map((pose) => (
          <button
            type="button"
            data-pose-button={pose.name}
            aria-pressed={pose.name === 'rest' ? 'true' : 'false'}
          >
            {pose.label}
          </button>
        ))}
      </div>
    ))}
  </fieldset>

  <fieldset>
    <legend>{TEXT.displayLegend}</legend>
    <label class="switch">
      <input type="checkbox" role="switch" data-mood-switch />
      {TEXT.professional}
    </label>
    <label class="switch">
      <input type="checkbox" role="switch" data-pivots-switch />
      {TEXT.showPivots}
    </label>
  </fieldset>

  <fieldset>
    <legend>{TEXT.viewLegend}</legend>
    {
      /* Turning around needs at least two drawn views; until then the control is left out. */
      showTurnControl && (
        <>
          <div class="slider">
            <label for="turn">{TEXT.turn}</label>
            <input type="range" id="turn" data-turn-slider min="0" max="359" step="1" value="0" />
            <output for="turn" data-turn-value>
              0°
            </output>
          </div>
          <p class="hint">{TEXT.turnHint}</p>
        </>
      )
    }
    <div class="slider">
      <label for="spin">{TEXT.spin}</label>
      <input type="range" id="spin" data-spin-slider min="-180" max="180" step="1" value="0" />
      <output for="spin" data-spin-value>
        0°
      </output>
    </div>
  </fieldset>

  <fieldset>
    <legend>{TEXT.rotationsLegend}</legend>
    {
      /* In the rig's own order (body, head, flippers, ...), which reads better than drawing order.
         The front sliders keep their ids (rotate-head); the side ones are rotate-side-head. */
      FIGURES.map((figure) => (
        <div data-figure-sliders={figure} hidden={figure !== 'front'}>
          {REPO_RIGS[figure].layers.map((layer) => {
            const id = figure === 'front' ? `rotate-${layer.name}` : `rotate-side-${layer.name}`;
            return (
              <div class="slider">
                <label for={id}>{layerLabel(layer.name, figure)}</label>
                <input
                  type="range"
                  id={id}
                  data-rotation={layer.name}
                  min={layer.rotate[0]}
                  max={layer.rotate[1]}
                  step="1"
                  value="0"
                />
                <output for={id} data-rotation-value={layer.name}>
                  0°
                </output>
              </div>
            );
          })}
        </div>
      ))
    }
  </fieldset>

  <fieldset>
    <legend>{TEXT.stretchesLegend}</legend>
    {
      /* Only the layers the rig lets stretch (bodies and heads), limited to their range. */
      FIGURES.map((figure) => (
        <div data-figure-stretches={figure} hidden={figure !== 'front'}>
          {REPO_RIGS[figure].layers.flatMap((layer) => {
            if (layer.stretch === undefined) return [];
            const id = figure === 'front' ? `stretch-${layer.name}` : `stretch-side-${layer.name}`;
            return [
              <div class="slider">
                <label for={id}>
                  {layerLabel(layer.name, figure)} {TEXT.stretch}
                </label>
                <input
                  type="range"
                  id={id}
                  data-stretch={layer.name}
                  min={layer.stretch[0]}
                  max={layer.stretch[1]}
                  step="0.01"
                  value="1"
                />
                <output for={id} data-stretch-value={layer.name}>
                  1.00
                </output>
              </div>,
            ];
          })}
        </div>
      ))
    }
  </fieldset>
</div>

<style>
  .controls {
    display: grid;
    gap: 1rem;
  }

  fieldset {
    border: 1px solid #c4c9d4;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem 1rem;
    /* Fieldsets refuse to shrink below their content by default, which breaks narrow phones. */
    min-width: 0;
  }

  legend {
    font-weight: 600;
    padding: 0 0.25rem;
  }

  .pose-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* `hidden` must win over the flex layout above. */
  .pose-buttons[hidden] {
    display: none;
  }

  .choices {
    display: flex;
    gap: 1.5rem;
  }

  button {
    font: inherit;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid #1f2a44;
    border-radius: 999px;
    background: #ffffff;
    color: #1f2a44;
    cursor: pointer;
  }

  button[aria-pressed='true'] {
    background: #1f2a44;
    color: #ffffff;
  }

  .switch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
  }

  .switch input {
    width: 1.25rem;
    height: 1.25rem;
  }

  .slider {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 4rem;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
  }

  .slider input {
    width: 100%;
    min-width: 0;
  }

  .hint {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
  }

  output {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>
