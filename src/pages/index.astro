---
/**
 * The root `/`: the English home page, without a redirect (README §5.1).
 *
 * Its canonical URL is `/en/` (set by HomePage), so search engines treat `/` and `/en/`
 * as one page instead of two copies.
 */
import HomePage from '../components/HomePage.astro';
import { DEFAULT_LOCALE } from '../i18n/locales';
---

<HomePage locale={DEFAULT_LOCALE} />
