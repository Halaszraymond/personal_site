---
/**
 * The home page in one language. Used by `/nl/`, `/hu/`, `/en/` and by `/` (English).
 * Phase 0 content: one test string per language.
 */
import type { Locale } from '../i18n/locales';
import { UI } from '../i18n/ui';
import { localeHomePath } from '../lib/alternates';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale} currentLocale={locale} canonicalPath={localeHomePath(locale)}>
  <slot name="before-content" />
  <h1>{UI[locale].testString}</h1>
</BaseLayout>
