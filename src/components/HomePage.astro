---
/**
 * The home page in one language. Used by `/nl/`, `/hu/`, `/en/` and by `/` (English).
 * The page is the dive (DivePage.astro); `/` adds the language hint before it.
 */
import type { Locale } from '../i18n/locales';
import DivePage from './DivePage.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<DivePage locale={locale}>
  <slot name="before-content" slot="before-content" />
</DivePage>
