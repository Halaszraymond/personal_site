---
/**
 * The frame around every page: <html>, <head> (title, canonical, language links)
 * and the header with the language switcher. Pages put their content in the <slot />,
 * extra `<head>` tags in `slot="head"`, and an animated scene for full mode in `slot="scene"`
 * (it goes into the scene slot of RenderModeSwitch; the dive puts Kálmán there).
 */
import type { Locale } from '../i18n/locales';
import { UI } from '../i18n/ui';
import { homeAlternates } from '../lib/alternates';
import LanguageSwitcher from './LanguageSwitcher.astro';
import RenderModeSwitch from './RenderModeSwitch.astro';

interface Props {
  /** The page's language, for `<html lang>`. */
  locale: Locale;
  /** The language whose page this is, or `null` for the 404, which has no single language. */
  currentLocale: Locale | null;
  /** Path of the canonical URL, e.g. `/en/`. Leave out for pages search engines should not index. */
  canonicalPath?: string;
  /** False for dev tools such as the Kálmán preview, which are not part of the public site. */
  showLanguageSwitcher?: boolean;
  /** A page-specific title for the browser tab; defaults to the site title. */
  title?: string;
  /** `dive` for the home pages' full-width dive layout; plain pages keep one narrow column. */
  layout?: 'page' | 'dive';
}

// `= true` is a default value, like `def f(show_language_switcher=True)` in Python.
const {
  locale,
  currentLocale,
  canonicalPath,
  showLanguageSwitcher = true,
  title,
  layout = 'page',
} = Astro.props;

// `Astro.site` comes from `site` in astro.config.ts. It is always set there,
// but TypeScript cannot know that, so we check instead of assuming.
if (Astro.site === undefined) {
  throw new Error('Set `site` in astro.config.ts: canonical and hreflang links need it.');
}
const site = Astro.site;
const indexable = canonicalPath !== undefined;

// Pages start in fallback mode (`data-render-mode="fallback"` below); the client switches
// to `full` only after its checks pass (see RenderModeSwitch.astro).
---

<!doctype html>
<html lang={locale} data-render-mode="fallback">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? UI[locale].siteTitle}</title>
    <meta name="description" content={UI[locale].description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {indexable && <link rel="canonical" href={new URL(canonicalPath, site).href} />}
    {indexable &&
      homeAlternates(site).map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))}
    {!indexable && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body data-layout={layout}>
    {showLanguageSwitcher && (
      <header>
        <LanguageSwitcher currentLocale={currentLocale} labelLocale={locale} />
      </header>
    )}
    <RenderModeSwitch>
      <slot name="scene" />
    </RenderModeSwitch>
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  /*
   * Remember the language when a visitor clicks a link marked with `data-lang-choice`
   * (the switcher and the language hint). The link itself navigates as usual.
   */
  import { isLocale } from '../i18n/locales';
  import { storeChoice } from '../i18n/choice-storage';

  for (const link of document.querySelectorAll<HTMLElement>('[data-lang-choice]')) {
    link.addEventListener('click', () => {
      // `dataset.langChoice` reads the `data-lang-choice` attribute.
      const choice = link.dataset['langChoice'];
      if (choice !== undefined && isLocale(choice)) {
        storeChoice(choice);
      }
    });
  }
</script>

<style is:global>
  /* Minimal readable defaults; the dive (DivePage.astro) brings its own layout and colours.
     The font choice is still open (README §8), so this is the system font stack. */
  body {
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    margin: 0 auto;
    max-width: 40rem;
    padding: 1rem;
    color: #111;
    background: #fff;
  }
</style>
