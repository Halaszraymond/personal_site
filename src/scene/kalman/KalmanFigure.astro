---
/**
 * Kálmán as a cut-out figure: one SVG, one image per rig layer (spec: kalman-rig).
 *
 * Drawn at build time, so Kálmán is in the HTML in the given pose (rest by default) and
 * shows without JavaScript. That is also what the static fallback will use (README §5.2).
 * kalman-figure-client.ts can change the pose afterwards by rewriting the same attributes.
 *
 * Every layer is a `<g>` (a group) with a `transform` from resolvePose(), holding an `<image>`.
 * The groups are flat and sorted by drawing order, not nested by parent: in SVG a nested child
 * is always drawn in front of its parent, and the far flipper must be able to sit behind the
 * body (kalman-rig design §3).
 */
import type { ImageMetadata } from 'astro';
import {
  resolvePose,
  spinMatrix,
  toSvgTransform,
  translate,
  type Mood,
} from '../../lib/kalman-rig';
import { viewImages, viewMatrix } from '../../lib/kalman-turntable';
import {
  FIGURES,
  poseNamed,
  REPO_DRAWN_POSES,
  REPO_RIG,
  REPO_RIGS,
  REPO_TURNTABLE,
} from './repo-rig';

interface Props {
  /** Name of a pose from poses.json; defaults to rest. */
  pose?: string;
  mood?: Mood;
  /**
   * What a screen reader says about the figure. Leave out for a decorative figure, which is
   * then hidden from assistive technology (the content is in the HTML around it).
   */
  label?: string;
  /**
   * Also draw a marker per pivot point, for the preview's "Show pivots" switch. They only show
   * while the figure has the `data-show-pivots` attribute (the SVG has no reliable `hidden`).
   */
  pivotMarkers?: boolean;
}

const { pose = 'rest', mood = 'goofy', label, pivotMarkers = false } = Astro.props;

// Every image under src/assets/kalman/, keyed by its path. `eager: true` imports them all now
// (at build time), like a dict comprehension over a folder; Astro then gives each one a
// hashed file name in the build. This is what lets rig.json name an image as plain text.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/kalman/**/*.{svg,png,webp,avif}',
  { eager: true },
);

function imageFor(file: string): ImageMetadata {
  const found = images[`../../assets/kalman/${file}`];
  if (found === undefined) {
    throw new Error(`rig.json names the image "${file}", which is not in src/assets/kalman/.`);
  }
  return found.default;
}

const [width, height] = REPO_RIG.artboard;
// The turntable's views, one group per angle and mood, hidden until the preview turns him. A
// mirrored view gets its source's image, flipped around the centre line.
const views = REPO_TURNTABLE.flatMap((view) => {
  const found = viewImages(REPO_TURNTABLE, view.name);
  if (found === undefined) return [];
  return Object.entries(found.images).map(([viewMood, placed]) => ({
    name: view.name,
    mood: viewMood,
    size: placed.size,
    transform: toSvgTransform(viewMatrix(found.mirrored ? -1 : 1, width / 2, placed.position)),
    image: imageFor(placed.image),
  }));
});
// The drawn poses (such as the bow), one group per pose and mood, hidden until an animation
// cross-fades one in (kalman-animation-feel design §8).
const drawnPoses = REPO_DRAWN_POSES.flatMap((drawn) =>
  Object.entries(drawn.images).map(([drawnMood, placed]) => ({
    name: drawn.name,
    mood: drawnMood,
    size: placed.size,
    transform: toSvgTransform(translate(placed.position)),
    image: imageFor(placed.image),
  })),
);
const chosenPose = poseNamed(pose);
// Both figures (front and side), each in its rest pose except the front one, which shows the
// chosen pose. Only the front shows at first; the preview and the player switch figures.
const figures = FIGURES.map((figure) => {
  const rig = REPO_RIGS[figure];
  const figurePose = figure === 'front' ? chosenPose : poseNamed('rest', figure);
  const layers = resolvePose(rig, figurePose, mood).map((resolved) => {
    const rigLayer = rig.layers.find((layer) => layer.name === resolved.name);
    if (rigLayer === undefined) throw new Error(`Unknown ${figure} layer ${resolved.name}`);
    return { ...resolved, size: rigLayer.size, image: imageFor(rigLayer.image) };
  });
  return { figure, layers };
});
---

<svg
  class="kalman-figure"
  viewBox={`0 0 ${width} ${height}`}
  data-kalman-figure
  data-pose={chosenPose.name}
  data-mood={mood}
  data-figure="front"
  role={label === undefined ? undefined : 'img'}
  aria-label={label}
  aria-hidden={label === undefined ? 'true' : undefined}
>
  {/* The whole figure turns as one piece inside this group (the preview's spin slider). */}
  <g data-spin transform={toSvgTransform(spinMatrix(REPO_RIG, 0))}>
    {
      /* The posable layers, one group per figure: the front shows while he faces front, the
         side while the side figure is chosen (kalman-animations design §2). */
      figures.map(({ figure, layers }) => (
        <g data-layers data-figure={figure} display={figure === 'front' ? 'inline' : 'none'}>
          {layers.map((layer) => (
            <g
              data-layer={layer.name}
              transform={toSvgTransform(layer.matrix)}
              visibility={layer.visible ? 'visible' : 'hidden'}
            >
              <image href={layer.image.src} width={layer.size[0]} height={layer.size[1]} />
            </g>
          ))}
        </g>
      ))
    }
    {/* The drawn poses: cross-faded in over the layers by the player, at a keyframe that names one. */}
    <g data-drawn-poses display="none">
      {drawnPoses.map((drawn) => (
        <g
          data-drawn-pose={drawn.name}
          data-drawn-mood={drawn.mood}
          transform={drawn.transform}
          visibility="hidden"
        >
          <image href={drawn.image.src} width={drawn.size[0]} height={drawn.size[1]} />
        </g>
      ))}
    </g>
    {/* The turntable's drawn views: shown instead of the layers once he turns around. */}
    <g data-turntable display="none">
      {views.map((view) => (
        <g
          data-view={view.name}
          data-view-mood={view.mood}
          transform={view.transform}
          visibility="hidden"
        >
          <image href={view.image.src} width={view.size[0]} height={view.size[1]} />
        </g>
      ))}
    </g>
    {pivotMarkers &&
      figures.map(({ figure, layers }) => (
        <g class="pivots" data-pivots data-figure={figure}>
          {layers.map((layer) => (
            <circle
              data-pivot={layer.name}
              cx={layer.pivotOnArtboard[0]}
              cy={layer.pivotOnArtboard[1]}
              r="9"
              visibility={layer.visible ? 'visible' : 'hidden'}
            />
          ))}
        </g>
      ))}
  </g>
</svg>

<style>
  .kalman-figure {
    display: block;
    width: 100%;
    height: auto;
    /* Raised flippers can reach past the artboard when he spins; draw them instead of cutting them off. */
    overflow: visible;
  }

  .pivots {
    display: none;
  }

  .kalman-figure[data-show-pivots] .pivots {
    display: inline;
  }

  /* Only the chosen figure's pivots show (CSS beats the SVG `display` attribute, so this is CSS). */
  .kalman-figure:not([data-figure='front']) .pivots[data-figure='front'],
  .kalman-figure:not([data-figure='side']) .pivots[data-figure='side'],
  .kalman-figure:not([data-figure='swim']) .pivots[data-figure='swim'] {
    display: none;
  }

  /* The pivots belong to the posable layers, which only show while he faces front. */
  .kalman-figure[data-turn]:not([data-turn='0']) .pivots {
    display: none;
  }

  /* Pivot markers: a dot with a ring that stands out on both navy and cream. */
  .pivots circle {
    fill: #e0465a;
    stroke: #ffffff;
    stroke-width: 4;
  }
</style>
