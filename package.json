{
  "name": "portfolio-site",
  "version": "0.0.0",
  "private": true,
  "description": "halaszraymond.com v2: a portfolio dive with Keizer Kálmán, an illustrated emperor penguin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:playground": "node --env-file=.env.playground node_modules/astro/bin/astro.mjs build",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "typecheck": "astro check",
    "test": "vitest run",
    "prepare": "simple-git-hooks",
    "e2e": "playwright test",
    "size": "node scripts/check-bundle-size.ts",
    "check:production": "node scripts/check-production-build.ts",
    "cut:kalman": "node scripts/cut-kalman-layers.ts && prettier --write src/scene/kalman/rig.json src/scene/kalman/turntable.json src/scene/kalman/drawn-poses.json",
    "check:kalman": "npm run cut:kalman && git diff --exit-code -- src/assets/kalman src/scene/kalman",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:kalman && npm run build && npm run check:production && npm run build:playground && npm run size && npm run e2e && npm run lighthouse",
    "lighthouse": "node scripts/run-lighthouse.ts"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css}": "prettier --write"
  }
}
